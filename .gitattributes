# Normalize repository text files
* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cff text eol=lf

# Preserve committed research-data bytes exactly
data/**/*.csv -text
data/**/*.png -text
data/**/*.jpg -text
data/**/*.jpeg -text

# Generated/binary scientific outputs
*.pdf -text
*.png -text
*.jpg -text
*.jpeg -text
